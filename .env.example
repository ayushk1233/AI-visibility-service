APP_ENV=local
DATABASE_PATH=db/kasparro.db
DATA_DIR=.
ANALYST_TOKEN=dev-analyst-token
REVIEWER_TOKEN=dev-reviewer-token
REVIEW_TTL_SECONDS=86400

# replay (default) or live
LLM_MODE=replay
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
# Used only in live mode; replay always reports replay-v1.
LLM_MODEL=llama3.2
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3
LLM_MAX_INPUT_CHARS=30000
LLM_MAX_OUTPUT_CHARS=4000
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_INPUT_COST_PER_1K=0
LLM_OUTPUT_COST_PER_1K=0

# Set true only in tests or for deterministic local runs.
SYNC_ANALYSIS=false
MAX_UPLOAD_BYTES=10485760
